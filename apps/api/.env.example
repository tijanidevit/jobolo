# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=Jobolo
NODE_ENV=development
PORT=3001

# URL of the Next.js frontend (used for CORS and email links)
FRONTEND_URL=http://localhost:3000

# ─── Database (MySQL) ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jobolo_dev
DB_USER=root
DB_PASS=

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── Mail / SMTP ──────────────────────────────────────────────────────────────
# Works with any SMTP provider. Example config for Resend:
#   MAIL_HOST=smtp.resend.com
#   MAIL_PORT=587
#   MAIL_SECURE=false
#   MAIL_USER=resend
#   MAIL_PASS=<your-resend-api-key>
#
# Leave MAIL_USER and MAIL_PASS empty in development to log emails to the console.
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@jobolo.app
MAIL_FROM_NAME=Jobolo
